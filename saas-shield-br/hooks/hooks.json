{
  "description": "saas-shield-br: bloqueia anti-patterns de RLS em migrations SQL e secrets em git commit (Bash e PowerShell); sugere /check-rls depois de editar migration.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-sql-antipattern.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-commit-secret-scan.mjs"],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(*git*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-commit-secret-scan.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-migration-edit.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
