{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*service-account*.json)",
      "Read(**/credentials*.json)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Bash(cat *.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(*supabase db reset --linked*)",
      "Bash(terraform destroy*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git restore *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D*)",
      "Bash(gh pr merge*)",
      "Bash(gh release*)",
      "Bash(gh repo delete*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(rm -rf*)",
      "Bash(*vercel*--prod*)",
      "Bash(*vercel promote*)",
      "Bash(*vercel rollback*)",
      "Bash(*vercel env*)",
      "Bash(*vercel remove*)",
      "Bash(*vercel domains*)",
      "Bash(*supabase db push*)",
      "Bash(*supabase db dump*)",
      "Bash(*supabase link*)",
      "Bash(*supabase migration repair*)",
      "Bash(*supabase functions deploy*)",
      "Bash(*supabase secrets*)",
      "Bash(*supabase projects*)",
      "Bash(*supabase branches*)",
      "Bash(psql*)",
      "Bash(pg_dump*)",
      "Bash(pg_restore*)",
      "Bash(gcloud * deploy*)",
      "Bash(gcloud secrets*)",
      "Bash(gcloud sql*)",
      "Bash(terraform apply*)",
      "Bash(docker push*)"
    ]
  }
}
